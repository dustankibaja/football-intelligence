# Application Settings
APP_ENV=development
APP_NAME=football-intelligence-system
DEBUG=True
LOG_LEVEL=INFO

# Database Settings (Local PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=football_intelligence

# Database Connection URL (Override if using custom DSN)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_intelligence

# Future Provider Secrets (Placeholders - Never commit real keys)
# LIVE_DATA_API_KEY=
# LIVE_DATA_API_BASE_URL=

# Private Footmo customer preview (disabled unless configured)
# CUSTOMER_API_TOKEN=use-a-long-random-token-for-private-staging-only
# CUSTOMER_ALLOWED_ORIGINS=http://localhost:5173

# Public launch additionally requires individual customer auth, billing,
# provider commercial rights, verified scientific soak and HTTPS.
