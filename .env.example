# Application Settings
APP_ENV=development
APP_NAME=football-intelligence-system
DEBUG=True
LOG_LEVEL=INFO

# Database Settings (Local PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=football_intelligence

# Database Connection URL (Override if using custom DSN)
# DATABASE_URL_OVERRIDE=postgresql+psycopg2://postgres:postgres@localhost:5432/football_intelligence

# Future Provider Secrets (Placeholders - Never commit real keys)
# LIVE_DATA_API_KEY=
# LIVE_DATA_API_BASE_URL=

# Private operator REST reads (disabled unless a strong server-only token is set)
# INTERNAL_RESEARCH_READ_TOKEN=

# Restricted-source network access is disabled by default.
# Do not export FOOTBALL_DATA_NETWORK_APPROVAL_REFERENCE unless documented provider rights cover the exact automated use.
